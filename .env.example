# Family Finance configuration.
# Copy to .env and adjust. The dev scripts (bun run dev:server / start) and
# docker/docker-compose.yml both read the .env file at the repository root.
# Every setting is optional.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# HTTP port. Default: 3000 for local dev. Docker always uses 8080 inside the
# container (change the host side of "ports" in docker-compose.yml instead).
#PORT=3000

# Folder that holds finance.db. Use an absolute path. Default: data/ at the
# repo root for local dev. Docker always uses /data (mounted from docker/data).
#DATA_DIR=/srv/family-finance/data

# Folder with the built web app (apps/web/dist). Rarely needs changing.
#WEB_DIST=

# Set to true when the app is served over HTTPS (e.g. behind Caddy/Traefik),
# so the session cookie gets the Secure flag. Default: false.
#COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# First-boot owner seeding
# ---------------------------------------------------------------------------
# If the database has no users yet, create the household and its owner from
# these values on startup, so the first-run setup page never appears. Useful
# when the app is reachable by others before you finish setting it up.
#
# - SEED_HOUSEHOLD_NAME, SEED_OWNER_USERNAME and SEED_OWNER_PASSWORD must be set
#   together; setting only some of them (or invalid values) stops the server
#   with an error.
# - Ignored once any user exists. Remove SEED_OWNER_PASSWORD after first boot.
# - Username: 2-32 chars, letters/numbers/dots/dashes/underscores.
# - Password: at least 10 characters.
#SEED_HOUSEHOLD_NAME=Our Household
#SEED_OWNER_USERNAME=jeremy
#SEED_OWNER_PASSWORD=change-me-to-something-long
# Optional; defaults to the username.
#SEED_OWNER_DISPLAY_NAME=Jeremy
