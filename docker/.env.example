# Docker Compose settings for this folder. Copy to docker/.env and adjust.
# Compose reads this file when filling in ${...} values in docker-compose.yml.
# App settings (TZ, SEED_*, ...) go in the repository root .env instead; see
# the .env.example there. Every setting is optional.

# Where the Cloudflare tunnel token is stored. Use an absolute path, or a path
# relative to this folder. Default: ./secrets/cloudflare-tunnel-token
#TUNNEL_TOKEN_FILE=/path/to/cloudflare-tunnel-token
